{
  "manifest_version": 3,
  "name": "RC Session Manager",
  "version": "2.3",
  "description": "Premium Local Session Manager with Ecosystem Sync & DOM Storage Injector. 100% Stealth Mode.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting",
    "browsingData"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
